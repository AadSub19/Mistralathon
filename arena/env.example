# Public URL phones should use to reach the arena (used for the QR code).
# If unset, the server derives http://<your-LAN-IP>:<port> automatically.
# PUBLIC_ARENA_URL=http://192.168.1.42:5173

# Mock event mode: "1" force mock for all teams, "0" disable mock, unset = auto
# (auto = real runs/<team>/events.jsonl when it exists, mock otherwise)
# ARENA_MOCK=

# API server port (default 8787)
# PORT=8787

# ---- Mistral + Voxtral race control -------------------------------------------
# With a key: commentary is written live by Mistral and voiced by Voxtral TTS.
# Without: deterministic race-control lines + browser voice. Put this in arena/.env
# MISTRAL_API_KEY=

# Optional overrides
# MISTRAL_COMMENTARY_MODEL=mistral-small-latest
# VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
# VOXTRAL_VOICE_ID=            # a preset/custom voice id (GET /v1/audio/voices)
# VOXTRAL_VOICE_NAME=          # preset by name, e.g. "Paul - Confident" (default: Oliver - Excited)
# VOXTRAL_TTS=0                # text commentary from Mistral, no audio
# COMMENTARY_INTERVAL_MS=7000  # min gap between Mistral commentary lines
